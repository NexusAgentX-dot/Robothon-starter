<mujoco model="nexus_dextraforge">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>
  <visual>
    <global offwidth="960" offheight="544"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.05 0.05 0.055" rgb2="0.12 0.12 0.13" width="256" height="256"/>
    <material name="floor" texture="grid" texrepeat="6 6" reflectance="0.12"/>
    <material name="palm" rgba="0.14 0.42 0.78 1"/>
    <material name="finger" rgba="0.78 0.86 0.92 1"/>
    <material name="tip" rgba="0.96 0.62 0.24 1"/>
    <material name="vial" rgba="0.18 0.75 0.70 0.72"/>
    <material name="cap" rgba="0.92 0.24 0.30 1"/>
    <material name="tray" rgba="0.14 0.16 0.18 1"/>
    <material name="ok" rgba="0.18 0.78 0.38 1"/>
    <material name="warn" rgba="1.0 0.80 0.18 1"/>
    <material name="load" rgba="0.50 0.38 0.96 1"/>
  </asset>

  <default>
    <geom condim="4" friction="1.3 0.04 0.004" solref="0.01 1" solimp="0.92 0.96 0.001"/>
    <joint damping="0.35" armature="0.01"/>
    <position kp="12" kv="2.5"/>
  </default>

  <worldbody>
    <light pos="0 -0.6 0.8" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light pos="-0.35 0.2 0.5" dir="0.5 -0.3 -1" diffuse="0.45 0.55 0.65"/>
    <camera name="demo" pos="0.40 -0.56 0.36" xyaxes="0.82 0.57 0 -0.23 0.33 0.92"/>

    <geom name="floor" type="plane" size="1.0 1.0 0.01" material="floor"/>
    <geom name="bench" type="box" pos="0.18 0 0.035" size="0.34 0.20 0.025" material="tray"/>

    <body name="vial" pos="0.165 0 0.135">
      <geom name="vial_glass" type="cylinder" size="0.025 0.060" material="vial" mass="0.08"/>
      <geom name="vial_label" type="box" pos="0 -0.026 0" size="0.021 0.002 0.022" rgba="1 1 1 0.85"/>
      <body name="cap" pos="0 0 0.080">
        <joint name="cap_twist" type="hinge" axis="0 0 1" range="0 260" damping="0.05"/>
        <geom name="cap_geom" type="cylinder" size="0.029 0.014" material="cap" mass="0.015"/>
        <geom name="cap_ridge" type="box" pos="0.021 0 0" size="0.008 0.002 0.015" material="warn"/>
      </body>
    </body>

    <body name="payload_marker" pos="0.165 0.075 0.175">
      <geom type="box" size="0.030 0.018 0.018" material="load" mass="0.72"/>
    </body>

    <body name="kit_slot_a" pos="0.285 -0.09 0.085">
      <geom type="box" size="0.050 0.030 0.010" material="ok"/>
    </body>
    <body name="kit_slot_b" pos="0.285 0.09 0.085">
      <geom type="box" size="0.050 0.030 0.010" material="warn"/>
    </body>

    <body name="hand" pos="0.020 0 0.165">
      <geom name="palm" type="box" size="0.048 0.064 0.020" material="palm" contype="1" conaffinity="1"/>

      <body name="thumb_1" pos="0.020 -0.058 0.002" euler="0 0 -32">
        <joint name="thumb_prox" type="hinge" axis="0 1 0" range="-5 82"/>
        <geom type="capsule" fromto="0 0 0 0.044 0 0" size="0.010" material="finger"/>
        <body name="thumb_2" pos="0.044 0 0">
          <joint name="thumb_mid" type="hinge" axis="0 1 0" range="-5 90"/>
          <geom type="capsule" fromto="0 0 0 0.034 0 0" size="0.009" material="finger"/>
          <body name="thumb_3" pos="0.034 0 0">
            <joint name="thumb_dist" type="hinge" axis="0 1 0" range="-5 95"/>
            <geom name="thumb_tip" type="capsule" fromto="0 0 0 0.024 0 0" size="0.008" material="tip"/>
            <site name="thumb_touch" pos="0.024 0 0" size="0.010"/>
          </body>
        </body>
      </body>

      <body name="index_1" pos="0.046 -0.036 0.010">
        <joint name="index_prox" type="hinge" axis="0 1 0" range="-5 92"/>
        <geom type="capsule" fromto="0 0 0 0.050 0 0" size="0.008" material="finger"/>
        <body name="index_2" pos="0.050 0 0">
          <joint name="index_mid" type="hinge" axis="0 1 0" range="-5 98"/>
          <geom type="capsule" fromto="0 0 0 0.037 0 0" size="0.007" material="finger"/>
          <body name="index_3" pos="0.037 0 0">
            <joint name="index_dist" type="hinge" axis="0 1 0" range="-5 98"/>
            <geom name="index_tip" type="capsule" fromto="0 0 0 0.026 0 0" size="0.0065" material="tip"/>
            <site name="index_touch" pos="0.026 0 0" size="0.009"/>
          </body>
        </body>
      </body>

      <body name="middle_1" pos="0.048 -0.012 0.012">
        <joint name="middle_prox" type="hinge" axis="0 1 0" range="-5 94"/>
        <geom type="capsule" fromto="0 0 0 0.054 0 0" size="0.008" material="finger"/>
        <body name="middle_2" pos="0.054 0 0">
          <joint name="middle_mid" type="hinge" axis="0 1 0" range="-5 100"/>
          <geom type="capsule" fromto="0 0 0 0.039 0 0" size="0.007" material="finger"/>
          <body name="middle_3" pos="0.039 0 0">
            <joint name="middle_dist" type="hinge" axis="0 1 0" range="-5 98"/>
            <geom name="middle_tip" type="capsule" fromto="0 0 0 0.026 0 0" size="0.0065" material="tip"/>
            <site name="middle_touch" pos="0.026 0 0" size="0.009"/>
          </body>
        </body>
      </body>

      <body name="ring_1" pos="0.046 0.014 0.010">
        <joint name="ring_prox" type="hinge" axis="0 1 0" range="-5 92"/>
        <geom type="capsule" fromto="0 0 0 0.050 0 0" size="0.008" material="finger"/>
        <body name="ring_2" pos="0.050 0 0">
          <joint name="ring_mid" type="hinge" axis="0 1 0" range="-5 98"/>
          <geom type="capsule" fromto="0 0 0 0.037 0 0" size="0.007" material="finger"/>
          <body name="ring_3" pos="0.037 0 0">
            <joint name="ring_dist" type="hinge" axis="0 1 0" range="-5 98"/>
            <geom name="ring_tip" type="capsule" fromto="0 0 0 0.025 0 0" size="0.0065" material="tip"/>
            <site name="ring_touch" pos="0.025 0 0" size="0.009"/>
          </body>
        </body>
      </body>

      <body name="little_1" pos="0.043 0.040 0.007">
        <joint name="little_prox" type="hinge" axis="0 1 0" range="-5 86"/>
        <geom type="capsule" fromto="0 0 0 0.044 0 0" size="0.0075" material="finger"/>
        <body name="little_2" pos="0.044 0 0">
          <joint name="little_mid" type="hinge" axis="0 1 0" range="-5 92"/>
          <geom type="capsule" fromto="0 0 0 0.033 0 0" size="0.0068" material="finger"/>
          <body name="little_3" pos="0.033 0 0">
            <joint name="little_dist" type="hinge" axis="0 1 0" range="-5 92"/>
            <geom name="little_tip" type="capsule" fromto="0 0 0 0.023 0 0" size="0.006" material="tip"/>
            <site name="little_touch" pos="0.023 0 0" size="0.008"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="a_thumb_prox" joint="thumb_prox"/>
    <position name="a_thumb_mid" joint="thumb_mid"/>
    <position name="a_thumb_dist" joint="thumb_dist"/>
    <position name="a_index_prox" joint="index_prox"/>
    <position name="a_index_mid" joint="index_mid"/>
    <position name="a_index_dist" joint="index_dist"/>
    <position name="a_middle_prox" joint="middle_prox"/>
    <position name="a_middle_mid" joint="middle_mid"/>
    <position name="a_middle_dist" joint="middle_dist"/>
    <position name="a_ring_prox" joint="ring_prox"/>
    <position name="a_ring_mid" joint="ring_mid"/>
    <position name="a_ring_dist" joint="ring_dist"/>
    <position name="a_little_prox" joint="little_prox"/>
    <position name="a_little_mid" joint="little_mid"/>
    <position name="a_little_dist" joint="little_dist"/>
  </actuator>

  <sensor>
    <touch name="thumb_pressure" site="thumb_touch"/>
    <touch name="index_pressure" site="index_touch"/>
    <touch name="middle_pressure" site="middle_touch"/>
    <touch name="ring_pressure" site="ring_touch"/>
    <touch name="little_pressure" site="little_touch"/>
    <jointpos name="cap_angle" joint="cap_twist"/>
  </sensor>
</mujoco>
